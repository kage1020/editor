# sharp is an optional dependency of Next.js used only by its image optimizer,
# which cannot run on the Cloudflare Workers runtime and which this project does
# not use (images.unoptimized is set and no route imports next/image).
#
# ignoredOptionalDependencies in package.json keeps Next from installing its own
# copy. miniflare declares sharp as a hard dependency, so a copy still exists in
# the store; excluding it from the hoisted fallback directory stops Next's
# image-optimizer from resolving that copy and dragging sharp's native .node
# binaries into the Worker bundle, which esbuild cannot load.
hoist-pattern[]=*
hoist-pattern[]=!sharp
hoist-pattern[]=!@img/*
