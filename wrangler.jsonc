/**
 * Local bindings for `next dev` only. OpenNext's getCloudflareContext gets them
 * from Wrangler's getPlatformProxy, which reads this file but not
 * cloudflare.config.ts. Deployments are described by cloudflare.config.ts.
 *
 * Without a preview database ID, the local D1 database is keyed by the same ID
 * that `pnpm migrate` applies migrations to.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "editor",
  "compatibility_date": "2026-08-19",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "editor",
      "database_id": "8037b9e6-9241-423b-9e85-8a44ac3feb00"
    }
  ],
  "r2_buckets": [
    {
      "binding": "UPLOADS",
      "bucket_name": "editor"
    }
  ]
}
