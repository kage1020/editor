/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "editor",
  "main": "worker.ts",
  // Wraps the OpenNext worker to add the cron handler below.
  "alias": {
    "open-next-worker": "./.open-next/worker.js"
  },
  "compatibility_date": "2026-08-19",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "keep_names": false,

  /**
   * Preview URLs are served from the workers.dev subdomain, so both flags are
   * needed for pull request builds to publish a version at
   * <version>-editor.<subdomain>.workers.dev. Without them a build uploads a
   * version but there is nothing to open.
   */
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "custom_domain": true,
      "pattern": "editor.kage1020.com"
    }
  ],
  /**
   * Smart Placement
   * Docs: https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
   */
  // "placement": { "mode": "smart" },

  /**
   * Bindings
   * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
   * databases, object storage, AI inference, real-time communication and more.
   * https://developers.cloudflare.com/workers/runtime-apis/bindings/
   */
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "editor",
      "database_id": "8037b9e6-9241-423b-9e85-8a44ac3feb00",
      "preview_database_id": "DB",
      "migrations_dir": "src/drizzle"
    }
  ],
  // Daily sweep of uploaded images no document shows any more.
  "triggers": {
    "crons": ["0 18 * * *"]
  },
  "r2_buckets": [
    {
      "binding": "UPLOADS",
      "bucket_name": "editor"
    }
  ]

  /**
   * Environment Variables
   * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
   */
  // "vars": { "MY_VARIABLE": "production_value" },
  /**
   * Note: Use secrets to store sensitive data.
   * https://developers.cloudflare.com/workers/configuration/secrets/
   */

  /**
   * Static Assets
   * https://developers.cloudflare.com/workers/static-assets/binding/
   */
  // "assets": { "directory": "./public/", "binding": "ASSETS" },

  /**
   * Service Bindings (communicate between multiple Workers)
   * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
   */
  // "services": [{ "binding": "MY_SERVICE", "service": "my-service" }]
}
